# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either legacy anon key or new publishable key (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Service Role (server-side only - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (for AI career coach, what-if simulator, resume feedback)
OPENAI_API_KEY=sk-your-openai-api-key

# Vercel (auto-set on deploy, optional for local)
# VERCEL_URL=
# VERCEL_ENV=
